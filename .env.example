# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only comma-separated UUIDs of explicitly authorized existing admins.
# Empty or malformed configuration denies access. Never prefix with NEXT_PUBLIC_.
ADMIN_USER_IDS=
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Required at build time and runtime. Use an isolated database for Vercel Preview.
# The app rejects empty/invalid URLs instead of defaulting to localhost.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@2avaraciveldecariacica.org
EMAIL_TO=2acivelcariacica@gmail.com

# Upstash Redis (required in production; missing configuration returns 503)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=AX...

# Vercel Cron
CRON_SECRET=random-32-char-string
